{
  "name": "GitHub desk - project health email",
  "description": "Read repository metadata, languages and three recent commits; inspect the backlog and archive state; email a project briefing. Setup: edit Repository settings (owner, repository, recipient, backlog threshold); select an Email credential on Send project briefing. Public repositories need no GitHub key within anonymous rate limits. Private repositories require an HTTP credential on all three fetch nodes. A failed fetch stops the email. Run workflow tests once; optional recurring runs use this Webhook trigger with authenticated scheduled POSTs.",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "kind": "webhook",
        "label": "Start project review",
        "position": {
          "x": 40,
          "y": 320
        },
        "config": {},
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "settings",
        "kind": "transform",
        "label": "Repository settings - edit me",
        "position": {
          "x": 340,
          "y": 320
        },
        "config": {
          "values": {
            "owner": "vercel",
            "repository": "next.js",
            "recipient": "you@example.com",
            "backlogThreshold": 20
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "repo",
        "kind": "http",
        "label": "Fetch repo",
        "position": {
          "x": 640,
          "y": 40
        },
        "config": {
          "url": "https://api.github.com/repos/{{nodes.settings.owner}}/{{nodes.settings.repository}}",
          "method": "GET",
          "headers": {
            "Accept": "application/vnd.github+json",
            "User-Agent": "m8m-workflow",
            "X-GitHub-Api-Version": "2026-03-10"
          },
          "credentialId": ""
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "languages",
        "kind": "http",
        "label": "Fetch languages",
        "position": {
          "x": 640,
          "y": 320
        },
        "config": {
          "url": "https://api.github.com/repos/{{nodes.settings.owner}}/{{nodes.settings.repository}}/languages",
          "method": "GET",
          "headers": {
            "Accept": "application/vnd.github+json",
            "User-Agent": "m8m-workflow",
            "X-GitHub-Api-Version": "2026-03-10"
          },
          "credentialId": ""
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "commits",
        "kind": "http",
        "label": "Fetch commits",
        "position": {
          "x": 640,
          "y": 600
        },
        "config": {
          "url": "https://api.github.com/repos/{{nodes.settings.owner}}/{{nodes.settings.repository}}/commits?per_page=3",
          "method": "GET",
          "headers": {
            "Accept": "application/vnd.github+json",
            "User-Agent": "m8m-workflow",
            "X-GitHub-Api-Version": "2026-03-10"
          },
          "credentialId": ""
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "repo-report",
        "kind": "transform",
        "label": "Read repository statistics",
        "position": {
          "x": 940,
          "y": 40
        },
        "config": {
          "values": {
            "name": "{{nodes.repo.full_name}}",
            "url": "{{nodes.repo.html_url}}",
            "stars": "{{nodes.repo.stargazers_count}}",
            "forks": "{{nodes.repo.forks_count}}",
            "openItems": "{{nodes.repo.open_issues_count}}",
            "archived": "{{nodes.repo.archived}}",
            "lastPush": "{{nodes.repo.pushed_at}}"
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "language-report",
        "kind": "transform",
        "label": "Collect language byte counts",
        "position": {
          "x": 940,
          "y": 320
        },
        "config": {
          "values": {
            "languages": "{{nodes.languages}}"
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "commit-report",
        "kind": "transform",
        "label": "Collect recent commit records",
        "position": {
          "x": 940,
          "y": 600
        },
        "config": {
          "values": {
            "commits": "{{nodes.commits}}"
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "project",
        "kind": "transform",
        "label": "Join project evidence",
        "position": {
          "x": 1240,
          "y": 320
        },
        "config": {
          "values": {
            "repository": "{{nodes.repo-report}}",
            "languages": "{{nodes.language-report}}",
            "commits": "{{nodes.commit-report}}"
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "backlog",
        "kind": "condition",
        "label": "Large issue / PR backlog?",
        "position": {
          "x": 1540,
          "y": 120
        },
        "config": {
          "value": "{{nodes.repo-report.openItems}}",
          "operator": "greaterThan",
          "compare": "{{nodes.settings.backlogThreshold}}"
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "backlog-yes",
        "kind": "transform",
        "label": "Open issues and PRs exceed your review threshold.",
        "position": {
          "x": 1840,
          "y": 45
        },
        "config": {
          "values": {
            "note": "Open issues and PRs exceed your review threshold."
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "backlog-no",
        "kind": "transform",
        "label": "Open issues and PRs are within your review threshold.",
        "position": {
          "x": 1840,
          "y": 195
        },
        "config": {
          "values": {
            "note": "Open issues and PRs are within your review threshold."
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "backlog-note",
        "kind": "transform",
        "label": "Collect selected advice",
        "position": {
          "x": 2140,
          "y": 120
        },
        "config": {
          "values": {
            "note": "{{input.note}}"
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "archived",
        "kind": "condition",
        "label": "Is the repository archived?",
        "position": {
          "x": 1540,
          "y": 520
        },
        "config": {
          "value": "{{nodes.repo-report.archived}}",
          "operator": "equals",
          "compare": true
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "archived-yes",
        "kind": "transform",
        "label": "Repository is archived: updates are disabled.",
        "position": {
          "x": 1840,
          "y": 445
        },
        "config": {
          "values": {
            "note": "Repository is archived: updates are disabled."
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "archived-no",
        "kind": "transform",
        "label": "Repository is not archived.",
        "position": {
          "x": 1840,
          "y": 595
        },
        "config": {
          "values": {
            "note": "Repository is not archived."
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "archived-note",
        "kind": "transform",
        "label": "Collect selected advice",
        "position": {
          "x": 2140,
          "y": 520
        },
        "config": {
          "values": {
            "note": "{{input.note}}"
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "email-copy",
        "kind": "transform",
        "label": "Compose project briefing",
        "position": {
          "x": 2500,
          "y": 320
        },
        "config": {
          "values": {
            "subject": "Project briefing | {{nodes.repo-report.name}}",
            "text": "PROJECT DESK\n\n{{nodes.repo-report.name}}\n{{nodes.repo-report.url}}\n\nStars: {{nodes.repo-report.stars}} | Forks: {{nodes.repo-report.forks}}\nOpen issues + pull requests: {{nodes.repo-report.openItems}}\nLast push: {{nodes.repo-report.lastPush}}\n\nREVIEW NOTES\n{{nodes.backlog-note.note}}\n{{nodes.archived-note.note}}\n\nLANGUAGE USAGE (bytes)\n{{nodes.language-report.languages}}\n\nTHREE RECENT COMMIT RECORDS\n{{nodes.commit-report.commits}}\n\nThese are repository signals, not a security or availability assessment.\nSource: GitHub REST API. Sent by m8m."
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "send",
        "kind": "email",
        "label": "Send project briefing",
        "position": {
          "x": 2800,
          "y": 320
        },
        "config": {
          "credentialId": "",
          "to": "{{nodes.settings.recipient}}",
          "subject": "{{nodes.email-copy.subject}}",
          "text": "{{nodes.email-copy.text}}"
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
        "id": "result",
        "kind": "transform",
        "label": "Record SMTP submission",
        "position": {
          "x": 3100,
          "y": 320
        },
        "config": {
          "values": {
            "repository": "{{nodes.repo-report.name}}",
            "smtp": "{{nodes.send}}"
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      }
    ],
