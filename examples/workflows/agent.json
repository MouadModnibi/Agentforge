          "x": 340,
          "y": 180
        },
        "config": {
          "agentId": "",
          "input": {
            "text": "{{input.text}}"
          }
        },
        "retry": {
          "attempts": 1,
          "delayMs": 1000
        },
        "timeoutMs": 30000
      },
      {
