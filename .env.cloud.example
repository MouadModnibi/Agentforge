# Free serverless deployment on Vercel + Turso. Never commit real values.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-database-token
APP_SECRET=replace-with-at-least-32-random-characters
APP_URL=https://your-app.vercel.app
ALLOW_REGISTRATION=true
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
LLM_MAX_RPM=8
TRIGGER_POLL_MS=60000
WORKFLOW_TIMEOUT_MS=600000
WORKFLOW_RUNTIME=serverless
CRON_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
# For the optional always-on Docker worker, use WORKFLOW_RUNTIME=worker instead.
# Each user adds their own Gemini key through Account settings.
