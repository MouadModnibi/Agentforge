# Copy to .env.docker. Compose never receives .env.local automatically.
# GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
LLM_MAX_RPM=8
APP_SECRET=replace-with-at-least-32-random-characters
ALLOW_REGISTRATION=true
APP_URL=http://localhost:3000
HOST_PORT=3000
TRIGGER_POLL_MS=60000
WORKFLOW_TIMEOUT_MS=600000
# Enable the tracking compose profile, then uncomment this:
# MLFLOW_TRACKING_URI=http://mlflow:5000

# Hosted SQLite (required on Vercel; same values on worker)
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
