# Legacy migration only. New users save their key in Account settings.
# Get yours at https://aistudio.google.com/app/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=

# Default Gemini model (optional)
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite

# Max LLM requests per minute (optional, default 8)
LLM_MAX_RPM=8

# App secret for encrypting stored secrets (required in production)
# Generate with: openssl rand -hex 32
APP_SECRET=change-me-to-a-random-32-char-hex-string

# Optional: Node environment
NODE_ENV=development

# Accounts are required in development and production.
ALLOW_REGISTRATION=true
APP_URL=http://localhost:3000

# Web and worker must use the same database path (default: data/agentforge.db).
# DATABASE_PATH=/absolute/path/to/agentforge.db
TRIGGER_POLL_MS=60000
WORKFLOW_TIMEOUT_MS=600000

# Optional metrics-only MLflow integration. No prompts or credentials are exported.
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_TOKEN=

# Hosted SQLite (required on Vercel; same values on worker)
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
